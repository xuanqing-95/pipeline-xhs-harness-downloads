{
  "name": "@local/redflow-workbench",
  "version": "0.5.4-beta.53",
  "private": true,
  "type": "module",
  "description": "玄清的小红书内容生成工作台 · DeepSeek Harness 插件版",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": {
    "name": "玄清",
    "url": "https://github.com/xuanqing-95"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/xuanqing-95/pipeline-xhs-harness-downloads",
  "keywords": [
    "deepseek-harness",
    "xiaohongshu",
    "xhs",
    "rednote",
    "content-generation",
    "玄清",
    "小红书内容生成"
  ]
}
